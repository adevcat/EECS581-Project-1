{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (MinGW + Qt 6.11.2)",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build",
      "environment": {
        "CC": "C:/Qt/Tools/mingw1310_64/bin/gcc.exe",
        "CXX": "C:/Qt/Tools/mingw1310_64/bin/g++.exe",
        "PATH": "C:/Qt/Tools/mingw1310_64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "Qt6_DIR": "C:/Qt/6.11.2/mingw_64/lib/cmake/Qt6",
        "CMAKE_C_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/Qt/Tools/mingw1310_64/bin/mingw32-make.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE"
      }
    },
    {
      "name": "default-linux",
      "displayName": "Default (GCC + Qt 6.11.2)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "environment": {
        "CC": "/usr/bin/gcc",
        "CXX": "/usr/bin/g++",
        "PATH": "/usr/bin:$penv{PATH}"
      },
      "cacheVariables": {
        "Qt6_DIR": "$env{HOME}/Qt/6.11.2/gcc_64/lib/cmake/Qt6",
        "CMAKE_C_COMPILER": "/usr/bin/gcc",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++",
        "CMAKE_MAKE_PROGRAM": "/usr/bin/make",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE"
      }
    }
  ]
}